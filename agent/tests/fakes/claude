#!/usr/bin/env python3
"""A stand-in for `claude -p --output-format json` (tests only)."""
import json, os, sys
prompt = sys.stdin.read()
args = sys.argv[1:]
print(json.dumps({
    "type": "result", "subtype": "success", "is_error": False, "result": "",
    "structured_output": {
        "prompt": prompt, "args": args, "phase": os.environ.get("HT_AGENT_PHASE"),
        "has_ha_token": "HT_AGENT_HA_TOKEN" in os.environ,
    },
    "total_cost_usd": 0.01, "num_turns": 1,
}))
