# Haushalttickets nightly run - /etc/haushalttickets-agent/agent.env (root:hausmeister 0640)
# Values without quotes and without spaces. haushalttickets-agent-ctl setup fills this in.

# Ticket server and the runner token (in the ticket LXC: haushalttickets-ctl nightly-setup)
HT_AGENT_TICKETS_URL=http://172.16.3.21:8080
HT_AGENT_TICKETS_TOKEN=

# Home Assistant and the long-lived token of the AI account "KI-Hausmeister"
HT_AGENT_HA_URL=https://172.16.3.2:8123
HT_AGENT_HA_TOKEN=
# CA bundle for HTTPS to Home Assistant (system store incl. your own CA after install)
HT_AGENT_HA_CA_FILE=/etc/ssl/certs/ca-certificates.crt

# Claude subscription token (claude setup-token)
CLAUDE_CODE_OAUTH_TOKEN=

# Private git repository for the configuration export (empty: local only)
HT_AGENT_GIT_REMOTE=
HT_AGENT_GIT_SSH_KEY=/var/lib/haushalttickets-agent/.ssh/ha-config

HT_AGENT_CLAUDE=/var/lib/haushalttickets-agent/.local/bin/claude
HT_AGENT_MODEL=opus
HT_AGENT_TIME_LIMIT_MINUTES=120
HT_AGENT_LANGUAGE=de
